# Copy to .env and fill in. Never commit .env.

# --- Clerk ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- Neon Postgres ---
# Dashboard -> Connection Details -> Pooled connection
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Paystack (PLAN.md Milestone 4/7) ---
# Dashboard -> Settings -> API Keys & Webhooks. Use TEST keys in dev.
PAYSTACK_SECRET_KEY=sk_test_xxx
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Set the webhook URL in the Paystack dashboard to:
#   https://<your-host>/api/webhooks/paystack
# In local dev, expose it with a tunnel (e.g. `npx ngrok http 8081`).

# --- ImageKit ---
IMAGEKIT_PRIVATE_KEY=private_xxx
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxx
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/xxx

# --- Inngest ---
INNGEST_DEV=1
INNGEST_SIGNING_KEY=signkey-xxx
INNGEST_EVENT_KEY=xxx

# --- Sentry ---
SENTRY_AUTH_TOKEN=xxx

# --- Unsplash (dev image seeding) ---
UNSPLASH_ACCESS_KEY=xxx
UNSPLASH_SECRET_KEY=xxx
